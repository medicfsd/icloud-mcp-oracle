# Copy to /etc/icloud-mcp.env on the server. root:root, mode 600.
# Do not commit the filled-in file. These values are placeholders.

ICLOUD_USER=you@icloud.com
ICLOUD_APP_PASSWORD=replace-with-app-specific-password
MCP_BEARER_TOKEN=replace-with-long-random-bearer
MCP_PUBLIC_HOST=your-name.duckdns.org

# Optional. The mailbox Apple uses for sent mail.
# ICLOUD_SENT_MAILBOX=Sent Messages
# ICLOUD_TIMEOUT_SECONDS=30
# ICLOUD_ATTACHMENT_MAX_BYTES=1000000
# MCP_PORT=8092

# Optional. IANA time zone for tool results and calendar writes.
# ICLOUD_TZ=America/Phoenix
